# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT Secret (generate a strong random string)
JWT_SECRET=your-secret-key-here

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-...

# App URL — used in password-reset emails (optional, has hardcoded fallback)
APP_URL=https://your-app.netlify.app

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_...
RESEND_FROM=noreply@yourdomain.com

# Suunto Cloud API (partner-app op https://apizone.suunto.com)
SUUNTO_CLIENT_ID=your-suunto-client-id
SUUNTO_CLIENT_SECRET=your-suunto-client-secret
SUUNTO_SUBSCRIPTION_KEY=your-suunto-subscription-key
# Notification secret voor webhook-verificatie (HMAC-SHA256). Zet exact dezelfde
# waarde als het "notification secret" in je Suunto OAuth-app instellingen.
# Notification URL in de Suunto-app: <APP_URL>/api/suunto-webhook
SUUNTO_NOTIFICATION_SECRET=your-suunto-notification-secret

